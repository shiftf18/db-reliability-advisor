logging {
  level = "info"
}
local.file_match "mongodb" {
  path_targets = [{
    __path__ = "/var/log/mongodb/mongod.log",
    service  = "mongodb",
    source   = "diagnostic-log",
  }]
}

loki.source.file "mongodb" {
  targets    = local.file_match.mongodb.targets
  forward_to = [loki.write.local.receiver]
}

local.file_match "orders_api" {
  path_targets = [{
    __path__ = "/var/log/orders-api/*.jsonl",
    service  = "orders-api",
    source   = "application-log",
  }]
}

loki.source.file "orders_api" {
  targets    = local.file_match.orders_api.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
